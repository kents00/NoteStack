{
    "functions": {
        "api/proxy.js": {
            "maxDuration": 60
        }
    },
    "rewrites": [
        {
            "source": "/api/(?!chat/)(.*)",
            "destination": "/api/proxy?path=$1"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}